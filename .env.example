# Bloberry server — environment (copy to .env, never commit real values)

# HTTP
SERVER_ADDR=127.0.0.1:8080
BLOBERRY_BASE_URL=http://localhost:8080

# Datastores
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=bloberry
REDIS_URI=redis://127.0.0.1:6379

# Auth (REQUIRED — generate with `openssl rand -base64 48`)
JWT_SECRET=change-me
CREDENTIAL_ENCRYPTION_KEY=change-me-at-least-16-bytes

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bloberry <no-reply@bloberry.app>

# Google OAuth (login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Rate limiting (per access key, PRD-Q5)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1h

# Object limits (Q1)
MAX_OBJECT_SIZE=5368709120
MULTIPART_PART_SIZE=16777216

# Audit retention (ERD-Q2)
AUDIT_RETENTION_DAYS=365
