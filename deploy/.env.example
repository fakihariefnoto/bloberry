# Bloberry server — staging/production environment
# Copy to /etc/bloberry/bloberry.env (mode 0600, owner root). Never commit real values.

SERVER_ADDR=127.0.0.1:8080
BLOBERRY_BASE_URL=https://bloberry.example.com
PUBLIC_BASE_URL=https://bloberry.example.com

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bloberry
REDIS_URI=redis://localhost:6379

# REQUIRED — generate with `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME
# REQUIRED — envelope-encrypts every storage-backend credential (TRD R7).
# Stored ONLY here, never in MongoDB, never in the repo.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_16_BYTES

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bloberry <no-reply@bloberry.example.com>

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1h

MAX_OBJECT_SIZE=5368709120
MULTIPART_PART_SIZE=16777216
AUDIT_RETENTION_DAYS=365

DISK_STORAGE_PATH=/var/lib/bloberry/objects
DISK_SIGNING_SECRET=CHANGE_ME
